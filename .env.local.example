ANTHROPIC_API_KEY=sk-ant-...

# Feedback / bug reports (route /api/feedback, envoi via Resend)
RESEND_API_KEY=re_...

# Destinataires. Valeurs par défaut dans app/api/feedback/route.ts :
#   FEEDBACK_TO_EMAIL   -> jean-baptiste@maijin.ch
#   FEEDBACK_FROM_EMAIL -> Pomodorian <feedback@pomodorian.app>
#   FEEDBACK_BCC_EMAIL  -> non défini (aucun CCI)
# hello@pomodorian.app n'a pas encore de MX : dès que le forwarding est en place,
# basculer sur FEEDBACK_TO_EMAIL=hello@pomodorian.app + FEEDBACK_BCC_EMAIL=jean-baptiste@maijin.ch
# FEEDBACK_TO_EMAIL=
# FEEDBACK_BCC_EMAIL=
# FEEDBACK_FROM_EMAIL=
