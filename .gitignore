# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf le fichier d'exemple, qui documente les variables et ne contient aucun secret
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
.playwright-cli/

# QA screenshots (local visual checks)
qa/shots/

# worktrees des sous-agents Claude Code (copies de travail temporaires)
/.claude/worktrees/

# sorties des tests navigateur (captures, résultats, profils)
/qa/e2e/shots/
/qa/e2e/*-results.txt
/qa/e2e/*.json
# ...sauf la référence des textes anglais, lue par i18n.js
!/qa/e2e/base-en.json
/qa/e2e/*.log
/qa/e2e/profile*/
